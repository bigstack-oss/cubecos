wait_for_netdev()
{
    local netdev=$1
    local timeout=$2

    local i=0
    while [ $i -lt $timeout ] ; do
        if ip link show $netdev >/dev/null 2>&1 ; then
            break
        else
            sleep 1
        fi
        i=$(expr $i + 1)
    done
    [ $i -lt $timeout ]
}

wait_for_zookeeper()
{
    local bind_host=$1
    local port=$2
    local timeout=$3

    local i=0
    while [ $i -lt $timeout ] ; do
        readiness=$(echo stat | nc $bind_host $port | wc -l)
        if [ $readiness -gt 0 ] ; then
            break
        else
            sleep 1
        fi
        i=$(expr $i + 1)
    done
}

wait_for_pacemaker()
{
    local timeout=$1

