cube_cluster_ppu()
{
    if $HEX_CLI -c cluster check | grep -q NG ; then
        $HEX_CLI -c cluster check_repair
    fi
    if $HEX_CLI -c cluster check | grep -q NG ; then
        Error "PPU upgrade aborted: fix NG services before continuing"
    fi

    local accessible_pkgs=$(cmd -v "/usr/sbin/hex_install list" | cut -d"|" -f3 | wc -l)
    local cluster_nodes=$(cubectl node list | wc -l)
    if [ $accessible_pkgs -lt $cluster_nodes ] ; then
        cmd -v /usr/sbin/hex_install list
        Error "Not every node in the cluster has access to firmware package"
    elif [ $accessible_pkgs -gt $cluster_nodes ] ; then
        cmd -v /usr/sbin/hex_install list
        Error "Make sure only one firmware package exists in /var/update/"
    else
        echo "All cluster nodes have proper access to CubeCOS firmware package: $(/usr/sbin/hex_install list)"
        for PKG in $(ls -1 /var/update/*.pkg) ; do
            if [ ! -e "$PKG" ] ; then
                Error "$PKG does not come with its corresponding md5 file: ${PKG}.md5"
            else
                expected_checksum=$(cat ${PKG}.md5 | awk '{ print $1 }')
                actual_checksum=$(/usr/bin/md5sum -z $PKG | awk '{ print $1 }')
                if [ "x$expected_checksum" != "x$actual_checksum" ] ; then
                    Error "Failed to verify checksum : ${PKG}.md5 $expected_checksum, $PKG $actual_checksum"
                else
                    echo "Successfully verified checksum"
                    echo "Cluster nodes to be upgraded: "
                    cubectl node list
                    echo "WARNING: upgrade in progress. DO NOT INTERRUPT PROGRAM"
                    cmd -v "(sleep 1 && echo 1 && sleep 1 && echo 1 && sleep 1 && echo YES) | $HEX_CLI -c update update ; sync"
                    echo "Successfully completed firmware package upgrade"
                    master_control=$(cubectl node list -j | jq -r .[].hostname | head -1)
                    echo "Please monitor CubeCOS login console (Blue/Black login banner) of individual node until the last node on list finishes"
                    if $HEX_SDK remote_run $master_control "$HEX_SDK is_compute_node" && [ $(cubectl node list -r compute | wc -l) -gt 1 ] ; then
                        if $HEX_SDK remote_run $master_control "pgrep qemu-kvm >/dev/null" ; then
                            echo "Enter YES to AUTOMATICALLY evacuate live VMs on $master_control"
                            $HEX_SDK remote_run $master_control "echo YES | $HEX_CLI -c iaas compute pre_failure_host_evacuation $master_control"
                            $HEX_SDK remote_run $master_control "for i in {1..60} ; do sleep 10 ; pgrep qemu-kvm >/dev/null || break ; done"
                        fi
                    fi
                    if $HEX_SDK remote_run $master_control "pgrep qemu-kvm >/dev/null" ; then
                        Error "some VMs on $master_control are still running (Please evacuate or shut them off and then continue with rebooting $master_control manually)"
                    else
                        echo "Enter YES to AUTOMATICALLY reboot each node in above sequence, starting with $master_control"
                        $HEX_SDK remote_run $master_control "$HEX_CLI -c reboot"
                    fi
                fi
            fi
        done
    fi
}

# Live-migration essential service comps (rolling restart). Repairable only --
# just the services the drain/live-migration path depends on. Used as a health
# gate by rolling restart (same version both sides of the reboot); NOT for
# rolling upgrade, where mixed-version skew makes these checks report NG as an
# expected transient. Tier 1 (foundational: DB/MQ/auth/VIP/clock/mon) is checked
# first; tier 2 (compute/network/data) in parallel after.
ROLLING_ESSENTIAL_TIER1="mysql rabbitmq memcache httpd haproxy haproxy_ha clock ceph_mon"
ROLLING_ESSENTIAL_TIER2="nova neutron ceph_osd ceph_mds"

_essential_check_one()
{
    # $1=comp $2=repair(1|0). Returns 0 if healthy (after optional repair).
    local c=$1 repair=$2
    if _OVERRIDE_MAX_ERR=1 $HEX_SDK health_${c}_check >/dev/null 2>&1 ; then
        printf ' %-14s ok\n' "$c"
        return 0
    fi
    if [ "$repair" = "1" ] ; then
        $HEX_SDK health_${c}_repair >/dev/null 2>&1
        if _OVERRIDE_MAX_ERR=1 $HEX_SDK health_${c}_check >/dev/null 2>&1 ; then
            printf ' %-14s repaired\n' "$c"
            return 0
        fi
    fi
    printf ' %-14s FAIL\n' "$c" >&2
    return 1
}

# live_migration_gate [timeout_secs] [drain_host] [repair]
# Block until the live-migration drain path is functional (version-robust:
# never asserts uniformity; excludes the draining node from target counts).
# With 'repair': a failed check triggers its surgical repair once, then
# re-checks -- a healthy pass has zero side effects. 0 = ready, 1 = timeout.
# Repair the one cause the gate named, at most once per cause per run. Causes
# with no branch (ceph, ceph-osd-down, drain-host-nova-down) are wait-only on
# purpose.
_live_migration_repair()
{
    local why=$1 _h

    case $why in
        galera)   Quiet -n $HEX_SDK -m force health_mysql_repair ;;
        rabbitmq) Quiet -n $HEX_CLI -c cluster check_repair MsgQueue ;;
        nova-conductor|nova-scheduler|no-migration-target|cinder-volume)
            # wedged API workers (backed-up recv-Q) and enabled-down services are
            # what an authenticated $OPENSTACK probe fails on
            cmd -c $HEX_SDK stale_api_check_repair openstack-nova-api 8774 nova-api python3 0
            cmd -c $HEX_SDK stale_api_check_repair openstack-cinder-api 8776 cinder-api python3 0
            if [ $($OPENSTACK compute service list -f value -c Status -c State 2>/dev/null | grep -ci "enabled down") -ge 1 ] ; then
                cmd -c systemctl restart openstack-nova-scheduler
                cmd -c systemctl restart openstack-nova-conductor
                cmd -p systemctl restart openstack-nova-compute
            fi
            ;;
        no-storage-ready-target)
            # a compute node can be nova-compute "up" yet have no cephfs mounted
            # (PPU-upgraded node) -> not a usable migration target. Mount it.
            for _h in $($OPENSTACK compute service list --service nova-compute -f value -c Host -c State 2>/dev/null | awk '$2=="up"{print $1}') ; do
                remote_run "$_h" 'mountpoint -q /mnt/cephfs' >/dev/null 2>&1 || remote_run "$_h" "$HEX_SDK ceph_mount_cephfs"
            done
            ;;
        neutron)
            cmd -c $HEX_SDK stale_api_check_repair neutron-server 9696 neutron-server server 0
            if [ $($OPENSTACK network agent list -f value -c ID -c Alive 2>/dev/null | grep -v -i true | wc -l) -ge 1 ] ; then
                $OPENSTACK network agent list -f json -c ID -c Alive | jq -r ".[] | select(.Alive == false).ID" | xargs -i $OPENSTACK network agent delete {}
                cmd -c "timeout $SRVLTO systemctl restart neutron-server neutron-ovn-metadata-agent neutron-ovn-vpn-agent"
            fi
            ;;
    esac
}

live_migration_gate()
{
    is_control_node || return 0
    source /etc/admin-openrc.sh 2>/dev/null
    local deadline=$((SECONDS + ${1:-300})) drain=${2:-__none__} repair=${3:-} why= repaired= _g0=$SECONDS

    while [ $SECONDS -lt $deadline ] ; do
        why=
        # version-SAFE cluster membership (true/false regardless of version)
        $HEX_SDK health_mysql_check    >/dev/null 2>&1 || why=galera
        [ -z "$why" ] && { $HEX_SDK health_rabbitmq_check >/dev/null 2>&1 || why=rabbitmq ; }
        [ -z "$why" ] && { $CEPH health 2>/dev/null | grep -qiE 'HEALTH_ERR|inactive|incomplete|peering|stale' && why=ceph ; }
        # wait for the rebooted node's OSDs to rejoin (in-but-down = not back);
        # tolerates degraded/recovering, does not require active+clean
        [ -z "$why" ] && {
            local _ndown=$($CEPH status -f json 2>/dev/null | jq -r '.osdmap | (.num_in_osds // 0) - (.num_up_osds // 0)' 2>/dev/null)
            [ "${_ndown:-0}" -gt 0 ] 2>/dev/null && why=ceph-osd-down
        }

        # FUNCTIONAL backends a live migration touches (NOT version-strict)
        [ -z "$why" ] && { $OPENSTACK compute service list --service nova-conductor -f value -c State 2>/dev/null | grep -qi up || why=nova-conductor ; }
        [ -z "$why" ] && { $OPENSTACK compute service list --service nova-scheduler -f value -c State 2>/dev/null | grep -qi up || why=nova-scheduler ; }
        [ -z "$why" ] && {
            # a target needs nova-compute up AND cephfs mounted -- an upgraded
            # node can heartbeat up while its instance storage is unmounted
            local _h tgt=0
            for _h in $($OPENSTACK compute service list --service nova-compute -f value -c Host -c State 2>/dev/null | awk '$2=="up"{print $1}') ; do
                [ "$_h" = "$drain" ] && continue
                remote_run "$_h" 'mountpoint -q /mnt/cephfs' >/dev/null 2>&1 && tgt=$((tgt+1))
            done
            [ "$tgt" -ge 1 ] || why=no-storage-ready-target
        }
        # the SOURCE host must be up in nova too (the target loop skips it);
        # wait for it, never restart it
        [ -z "$why" ] && [ "$drain" != "__none__" ] && {
            $OPENSTACK compute service list --service nova-compute --host "$drain" -f value -c State 2>/dev/null \
                | grep -qi up || why=drain-host-nova-down
        }
        [ -z "$why" ] && { $OPENSTACK volume service list --service cinder-volume -f value -c State 2>/dev/null | grep -qi up || why=cinder-volume ; }
        [ -z "$why" ] && { $OPENSTACK network agent list -f value -c Alive 2>/dev/null | grep -qi true || why=neutron ; }

        if [ -z "$why" ] ; then
            # Only log a meaningful pass (it had to wait or repair) -- an instant
            # no-op pass is the common case and would be noise.
            if [ -n "$repaired" ] || [ $((SECONDS - _g0)) -ge 3 ] ; then
                log_info "live_migration_gate: path ready for $drain after $((SECONDS - _g0))s${repaired:+ (repaired:$repaired)}"
                /usr/sbin/hex_log_event -e CLU00011I "interface=system,host=$drain,category=cluster,action=gate_passed,waited=$((SECONDS - _g0)),repaired=${repaired// /+}"
            fi
            return 0
        fi
        # repair mode: fix what the failed check names, once per cause, then
        # re-check immediately. ceph/ceph-osd-down get no repair -- OSD rejoin
        # is time-based and the rolling noout guard already prevents churn.
        if [ "$repair" = "repair" ] ; then
            case " $repaired " in
                *" $why "*) : ;;    # already repaired this cause; just wait
                *)
                    repaired="$repaired $why"
                    log_warning "live_migration_gate: $drain blocked on '$why', attempting repair"
                    Quiet -n influx_event "insert health,component=live_migration_gate,node=$HOSTNAME,code=0 description=\"repairing\",detail=\"$why\""
                    _live_migration_repair "$why"
                    continue
                    ;;
            esac
        fi
        sleep 5
    done
    log_error "live_migration_gate: path for $drain NOT ready after $((SECONDS - _g0))s, blocked on: ${why:-unknown}"
    /usr/sbin/hex_log_event -e CLU00012W "interface=system,host=$drain,category=cluster,action=gate_timeout,blocked_on=${why:-unknown},waited=$((SECONDS - _g0))"
    echo "live_migration_gate: live-migration path not ready ($why)" >&2
    return 1
}

cluster_check_repair_essential()
{
    # $1=repair (1) or check-only (0, default). Only the live-migration path.
    # 2-tier: services within each tier run in parallel; tier 1 (foundational)
    # completes before tier 2 (dependent).
    local repair=${1:-0} rc=0 c p pids
    for tier in "$ROLLING_ESSENTIAL_TIER1" "$ROLLING_ESSENTIAL_TIER2" ; do
        pids=""
        for c in $tier ; do
            _essential_check_one "$c" "$repair" & pids="$pids $!"
        done
        for p in $pids ; do wait "$p" || rc=1 ; done
    done
    return $rc
}

# Wait until every node has committed (CUBE_DONE marker), bounded by $1 seconds
# (default 1500). Returns 0 when all committed, 1 on timeout.
cube_wait_all_committed()
{
    local timeout=${1:-1500} waited=0 nodes n allup
    nodes=$(cubectl node list -j 2>/dev/null | jq -r '.[].hostname')
    [ -n "$nodes" ] || return 0
    while [ $waited -lt $timeout ] ; do
        allup=1
        for n in $nodes ; do
            remote_run "$n" "[ -e $CUBE_DONE ]" || { allup=0 ; break ; }
        done
        [ "$allup" = 1 ] && return 0
        sleep 10 ; waited=$((waited+10))
    done
    return 1
}

cluster_check_repair_async()
{
    # Run the final cluster check_repair off the caller's critical path so the
    # operator gets their prompt back immediately and can start using the box.
    # The result is popped onto the console device(s) and broadcast (wall) when
    # it finishes. Detached via setsid so it survives the parent CLI exiting.
    # Held until all nodes have committed so it fires once on a settled cluster.
    # Hidden opt-out: skip the check_repair if the agent dropped the marker (see
    # #1225) -- but ALWAYS restore the VMs recorded at cluster stop. The opt-out
    # suppresses health repair so faults stay visible; it must not strand a
    # customer's running VMs SHUTOFF after a poweroff/power-loss cycle.
    setsid bash -c '
        hex_sdk cube_wait_all_committed 1500
        if [ ! -f /etc/appliance/state/cube_repair_optout ] ; then
            out=$(hex_cli -c cluster check_repair 2>&1 | grep -av "Broken pipe")
        fi
        hex_sdk power_restore_recorded_vms
        # Bring-up really is done now: the recorded VMs are back, so release the
        # planned-maintenance gate and arm the monitors directly rather than
        # waiting out RestartSec. Must follow the restore -- arming while the
        # amphorae are still SHUTOFF makes octavia rebuild every one of them.
        hex_sdk os_planned_maintenance_clear
        hex_sdk os_masakari_monitors start
        cubectl node exec -r compute -p "systemctl start octavia-health-manager" >/dev/null 2>&1
        [ -n "$out" ] || exit 0
        con=$(hex_sdk GetKernelConsoleDevices)
        { echo "" ; echo "===== cluster check_repair complete =====" ; echo "$out" ; echo "=========================================" ; } | tee $con 2>/dev/null | wall 2>/dev/null
    ' </dev/null >/dev/null 2>&1 &
}

node_bootstrap_status()
{
    local node=${1:-$HOSTNAME}
    remote_run $node "tr '\r' '\n' </run/cube_bootstrap.log | tail -1"
}

fixpack_sync()
{
    local action=$1

    if [ "x$action" = "xinstall" ] ; then
        hex_sdk git_push "$FIXPACK_ID $FIXPACK_NAME ROLLBACK=$ROLLBACK $FIXPACK_DESCRIPTION Installed"
    else
        hex_sdk git_push "$FIXPACK_ID $FIXPACK_NAME ROLLBACK=$ROLLBACK $FIXPACK_DESCRIPTION Uninstalled"
    fi
    hex_sdk cmd "chmod 4755 /usr/sbin/hex_{config,cli,firsttime}"
    hex_sdk cmd "[ $HOSTNAME = \$HOSTNAME ] || rm -rf $ROLLBACK_DIR"
    cubectl node rsync $ROLLBACK_DIR >/dev/null 2>&1
    cubectl node rsync /var/appliance-db/fixpack.history >/dev/null 2>&1
}
