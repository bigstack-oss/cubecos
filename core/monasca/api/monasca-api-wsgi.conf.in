Listen @BIND_ADDR@8070

TraceEnable off

<VirtualHost *:8070>
    ProxyPreserveHost On
    ProxyRequests Off

    # Forward all traffic to the monasca-api gunicorn UNIX socket. The
    # application moved into the python 3.10 venv and mod_wsgi is built against
    # the system python 3.9, so httpd can only proxy it, not host it in-process.
    # Using a random 127.0.0.x address to prevent Apache from keeping the
    # connection to the wrong proxy destination.
    ProxyPass / unix:/var/lib/monasca/monasca-api.socket|http://127.0.0.3/
    ProxyPassReverse / unix:/var/lib/monasca/monasca-api.socket|http://127.0.0.3/

    <IfVersion >= 2.4>
      ErrorLogFormat "%{cu}t %M"
    </IfVersion>

    LogLevel info
    ErrorLog /var/log/httpd/monasca-api_error.log
    CustomLog /var/log/httpd/monasca-api.log combined

    SetEnv no-gzip 1

</VirtualHost>
