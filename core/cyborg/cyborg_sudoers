Defaults:cyborg !requiretty

# This is what [cyborg_sys_admin] helper_command in cyborg.conf points at, and it has
# to stay byte-identical to what config_cyborg.cpp writes there: sudo matches the
# command by path, so a helper_command that names a path this file does not authorise
# is refused with "cyborg : command not allowed", before privsep gets far enough to
# report anything of its own.
#
# The path is the epoxy venv's own helper. A privsep helper imports the caller's own
# package, so it has to follow cyborg across every venv boundary: #633 moved it into the
# python 3.11 caracal venv, and #659 moved it on into the python 3.12 epoxy one, whose
# helper is the only one that can import cyborg 14.1.0.
cyborg ALL = (root) NOPASSWD: /opt/openstack-epoxy/bin/privsep-helper *