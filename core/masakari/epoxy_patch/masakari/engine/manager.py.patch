+    @staticmethod
+    def _instance_off_reporting_host(context, notification):
+        """Return (reporter, nova host) if they differ, else None."""
+        try:
+            reporter = objects.Host.get_by_uuid(
+                context, notification.source_host_uuid).name
+            server = nova_api.API().get_server(
+                context, notification.payload.get('instance_uuid'))
+        except Exception:
+            # lookup failures are left to the recovery flow
+            return None
+        host = getattr(server, 'OS-EXT-SRV-ATTR:host', None)
+        if not host or not reporter:
+            return None
+
+        def short(name):
+            return name.split('.')[0].lower()
+
+        if short(host) == short(reporter):
+            return None
+        return reporter, host
+
