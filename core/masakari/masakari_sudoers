Defaults:masakari !requiretty

# This is what [masakarimonitors_privileged] helper_command in
# masakarimonitors.conf points at, and it has to stay byte-identical to what
# config_masakari.cpp writes there: sudo matches the command by path, so a
# helper_command that names a path this file does not authorise is refused with
# "masakari : command not allowed", before privsep gets far enough to report anything
# of its own.
#
# The path is the epoxy venv's own helper. There is no /usr/bin/privsep-helper any more
# -- it pointed at the antelope venv until #639 took masakari-monitors to caracal -- and
# the caracal helper #639 named instead cannot import the masakarimonitors that moved to
# the python 3.12 venv with the epoxy hop (#665).
masakari ALL = (root) NOPASSWD: /opt/openstack-epoxy/bin/privsep-helper *
