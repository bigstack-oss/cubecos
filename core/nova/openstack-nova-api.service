[Unit]
Description=OpenStack Nova API Server
After=syslog.target network.target

[Service]
Type=notify
NotifyAccess=all
Restart=always
# need-app in nova-api-uwsgi.ini ends the instance while the database is not up yet;
# the default 100ms would run into systemd's start limit before it is
RestartSec=5s
User=nova
# /etc/nova/nova-api-uwsgi.ini is rendered by config_nova.cpp from nova-api-uwsgi.ini.in
ExecStart=/usr/bin/uwsgi --ini /etc/nova/nova-api-uwsgi.ini
# Signal only the uWSGI master on stop; it shuts its workers down itself. See
# openstack-placement-api.service for the worker deadlock the default control-group
# mode causes under uWSGI.
KillMode=mixed

[Install]
WantedBy=multi-user.target
