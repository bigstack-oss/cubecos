# Specify the PCI devices available to VMs. For more information, refer to the
# documentation. (multi valued)
# Deprecated group/name - [pci]/passthrough_whitelist
# Deprecated group/name - [DEFAULT]/pci_passthrough_whitelist
#device_spec =

