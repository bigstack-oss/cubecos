     # TODO(stephenfin): This logic would be so much easier to grok if we
     # finally split resize and cold migration into separate code paths
+    def _lr_validate(self, context, instance, old, new, is_bfv):
+        # cube live-resize preconditions (grow-only, within the ceiling)
+        def _bad(reason):
+            raise exception.LiveResizeError(reason=reason)
+        if new.id == old.id:
+            _bad(_("target flavor is the current flavor"))
+        for f in (old, new):
+            b = clr.blocked(f)
+            if b:
+                _bad(_("flavor %(name)s uses %(spec)s") % {
+                    "name": f.name, "spec": b})
+        if new.vcpus < old.vcpus or new.memory_mb < old.memory_mb:
+            _bad(_("live resize is grow-only"))
+        if new.root_gb != old.root_gb and not is_bfv:
+            _bad(_("root disk size must not change"))
+        if new.ephemeral_gb != old.ephemeral_gb:
+            _bad(_("ephemeral disk size must not change"))
+        # ceiling the running domain was booted with (config default or
+        # extra-spec override); the driver re-checks the real domain XML
+        max_vcpus, max_mem = clr.headroom(old)
+        if new.vcpus > old.vcpus and new.vcpus > max_vcpus:
+            _bad(_("target vCPUs exceed this instance's hotplug "
+                   "ceiling (%d)") % max_vcpus)
+        if new.memory_mb > old.memory_mb and new.memory_mb > max_mem:
+            _bad(_("target memory exceeds this instance's hotplug "
+                   "ceiling (%d MB)") % max_mem)
+        # a guest that has live-migrated cannot online hot-added vCPUs
+        # until it reboots (#1269); memory hotplug is unaffected
+        if (new.vcpus > old.vcpus and
+                instance.system_metadata.get(clr.SYSMETA_MIGRATED)):
+            _bad(_("this instance has been live-migrated since it last "
+                   "booted; its guest cannot online hot-added vCPUs until "
+                   "it is hard-rebooted (memory-only grows still work)"))
+
+    @check_instance_lock
+    @check_instance_state(vm_state=[vm_states.ACTIVE], task_state=[None])
+    @check_instance_host(check_is_up=True)
+    def live_resize(self, context, instance, flavor_id):
+        """Cube live-resize: grow a RUNNING instance to flavor_id."""
+        new_flavor = flavors.get_flavor_by_flavor_id(flavor_id,
+                                                     read_deleted="no")
+        old_flavor = instance.flavor
+        is_bfv = compute_utils.is_volume_backed_instance(context, instance)
+        self._lr_validate(context, instance, old_flavor, new_flavor, is_bfv)
+        self._check_quota_for_upsize(context, instance, old_flavor,
+                                     new_flavor, is_bfv, is_revert=False)
+        instance.task_state = task_states.LIVE_RESIZING
+        instance.save(expected_task_state=[None])
+        objects.InstanceAction.action_start(context, instance.uuid,
+                                            instance_actions.LIVE_RESIZE)
+        self.compute_task_api.live_resize_instance(context, instance,
+                                                   new_flavor)
+
