+    def _guest_add_live_resize_headroom(self, guest, flavor):
+        # cube live-resize: declare the hotplug ceiling at boot; (0, 0)
+        # means the flavor is blocked or opted out.
+        max_vcpus, max_mem_mb = clr.headroom(flavor)
+        if max_vcpus > flavor.vcpus:
+            guest.vcpus = max_vcpus
+            guest.vcpus_current = flavor.vcpus
+        if max_mem_mb > flavor.memory_mb:
+            if guest.max_memory_size is not None:
+                return  # vpmem already owns maxMemory; don't fight it
+            guest.max_memory_size = max_mem_mb * units.Ki
+            guest.max_memory_slots = clr.MEM_SLOTS
+            # libvirt requires a guest NUMA topology for memory hotplug;
+            # synthesize one flat cell when the instance has none.
+            if guest.cpu is not None and not guest.cpu.numa:
+                cell = vconfig.LibvirtConfigGuestCPUNUMACell()
+                cell.id = 0
+                cell.cpus = set(range(guest.vcpus))
+                cell.memory = flavor.memory_mb * units.Ki
+                numa = vconfig.LibvirtConfigGuestCPUNUMA()
+                numa.cells = [cell]
+                guest.cpu.numa = numa
+
     def _guest_add_vpmems(self, guest, vpmems):
