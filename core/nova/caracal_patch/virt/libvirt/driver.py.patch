+    def _guest_add_live_resize_headroom(self, guest, flavor):
+        # cube live-resize: declare the hotplug ceiling at boot; (0, 0)
+        # means the flavor is blocked or opted out.
+        max_vcpus, max_mem_mb = clr.headroom(flavor)
+        if max_vcpus > flavor.vcpus and guest.cpu is not None:
+            # libvirt requires sockets*cores*threads == MAX vcpus; scale
+            # sockets, or skip cpu headroom if it does not divide evenly.
+            per_socket = (guest.cpu.cores or 1) * (guest.cpu.threads or 1)
+            if max_vcpus % per_socket == 0:
+                guest.cpu.sockets = max_vcpus // per_socket
+            else:
+                max_vcpus = 0
+        if max_vcpus > flavor.vcpus:
+            guest.vcpus = max_vcpus
+            guest.vcpus_current = flavor.vcpus
+        if max_mem_mb > flavor.memory_mb:
+            if guest.max_memory_size is not None:
+                return  # vpmem already owns maxMemory; don't fight it
+            guest.max_memory_size = max_mem_mb * units.Ki
+            guest.max_memory_slots = clr.MEM_SLOTS
+            # libvirt requires a guest NUMA topology for memory hotplug;
+            # synthesize one flat cell when the instance has none.
+            if guest.cpu is not None and not guest.cpu.numa:
+                cell = vconfig.LibvirtConfigGuestCPUNUMACell()
+                cell.id = 0
+                cell.cpus = set(range(guest.vcpus))
+                cell.memory = flavor.memory_mb * units.Ki
+                numa = vconfig.LibvirtConfigGuestCPUNUMA()
+                numa.cells = [cell]
+                guest.cpu.numa = numa
+
+    def check_live_resize(self, instance, new_flavor):
+        # cube live-resize: can the RUNNING domain grow to new_flavor?
+        # The domain's baked-in ceiling is authoritative, not the config.
+        guest = self._host.get_guest(instance)
+        old = instance.flavor
+        if new_flavor.vcpus > old.vcpus:
+            max_vcpus = guest._domain.maxVcpus()
+            if max_vcpus < new_flavor.vcpus:
+                raise exception.LiveResizeError(reason=_(
+                    "domain vCPU ceiling %(max)d < requested %(want)d "
+                    "(instance must be rebooted to gain headroom)") % {
+                        "max": max_vcpus, "want": new_flavor.vcpus})
+        if new_flavor.memory_mb > old.memory_mb:
+            tree = etree.fromstring(guest.get_xml_desc())
+            maxmem = tree.find("./maxMemory")
+            if maxmem is None or int(maxmem.text) < (
+                    new_flavor.memory_mb * units.Ki):
+                raise exception.LiveResizeError(reason=_(
+                    "domain memory ceiling missing or too small "
+                    "(instance must be rebooted to gain headroom)"))
+
+    def live_resize(self, context, instance, new_flavor):
+        # cube live-resize: memory first (clean abort), then vCPUs.
+        guest = self._host.get_guest(instance)
+        old = instance.flavor
+        mem_delta_kb = (new_flavor.memory_mb - old.memory_mb) * units.Ki
+        dev = None
+        if mem_delta_kb > 0:
+            dev = vconfig.LibvirtConfigGuestMemoryDevice()
+            dev.target_size = mem_delta_kb
+            dev.target_node = 0
+            try:
+                guest.attach_device(dev, persistent=True, live=True)
+            except libvirt.libvirtError as ex:
+                raise exception.LiveResizeError(reason=str(ex))
+        if new_flavor.vcpus > old.vcpus:
+            flags = (libvirt.VIR_DOMAIN_AFFECT_LIVE |
+                     libvirt.VIR_DOMAIN_AFFECT_CONFIG)
+            try:
+                guest._domain.setVcpusFlags(new_flavor.vcpus, flags)
+            except libvirt.libvirtError as ex:
+                if dev is None:
+                    raise exception.LiveResizeError(reason=str(ex))
+                try:
+                    guest.detach_device(dev, persistent=True, live=True)
+                except Exception:
+                    LOG.exception("live-resize: DIMM rollback failed",
+                                  instance=instance)
+                    raise exception.LiveResizePartial(reason=str(ex))
+                raise exception.LiveResizeError(reason=str(ex))
+        LOG.info("live-resize applied: %(ov)d->%(nv)d vCPU, "
+                 "%(om)d->%(nm)d MB",
+                 {"ov": old.vcpus, "nv": new_flavor.vcpus,
+                  "om": old.memory_mb, "nm": new_flavor.memory_mb},
+                 instance=instance)
+
