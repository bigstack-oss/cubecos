+class LibvirtConfigGuestMemoryDevice(LibvirtConfigGuestDevice):
+    """<memory model='dimm'> device for memory hot-add (cube live-resize)."""
+
+    def __init__(self, **kwargs):
+        super(LibvirtConfigGuestMemoryDevice, self).__init__(
+            root_name="memory", **kwargs)
+
+        self.model = "dimm"
+        self.target_size = kwargs.get("size_kb", 0)
+        self.target_node = 0
+
+    def format_dom(self):
+        memory = super(LibvirtConfigGuestMemoryDevice, self).format_dom()
+
+        memory.set("model", self.model)
+
+        target = etree.Element("target")
+        target.append(self._text_node("size", self.target_size))
+        target.append(self._text_node("node", self.target_node))
+        memory.append(target)
+
+        return memory
