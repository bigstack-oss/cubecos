[Unit]
Description=OpenStack Nova Metadata API Server
After=syslog.target network.target

[Service]
Type=notify
NotifyAccess=all
Restart=always
# as openstack-nova-api.service
RestartSec=5s
User=nova
# /etc/nova/nova-metadata-uwsgi.ini is rendered by config_nova.cpp from nova-metadata-uwsgi.ini.in
ExecStart=/usr/bin/uwsgi --ini /etc/nova/nova-metadata-uwsgi.ini
# as openstack-nova-api.service
KillMode=mixed

[Install]
WantedBy=multi-user.target
