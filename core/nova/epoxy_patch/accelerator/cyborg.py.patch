@@ -53,8 +55,37 @@
 """
 
 LOG = logging.getLogger(__name__)
+CONF = nova.conf.CONF
 
+_SERVICE_USER_AUTH = None
 
+
+def _get_service_user_auth():
+    """Build an auth plugin from the [service_user] credentials.
+
+    Needed when the context carries no user token, as on the
+    resume-on-host-boot path and when init_host() finishes an
+    interrupted delete: nova-compute works there from an admin context
+    it creates itself. service_auth.get_auth_plugin() cannot build the
+    user half of that case -- left to the context it wraps a tokenless
+    user auth, and keystoneauth then fails while assembling the request
+    headers -- so this supplies it, and the caller still has
+    get_auth_plugin() add the service token.
+    """
+    global _SERVICE_USER_AUTH
+    if _SERVICE_USER_AUTH is None:
+        _SERVICE_USER_AUTH = ks_loading.load_auth_from_conf_options(
+            CONF, nova.conf.service_token.SERVICE_USER_GROUP)
+        if _SERVICE_USER_AUTH is None:
+            raise exception.AcceleratorRequestOpFailed(
+                op=_('get'),
+                msg=_('Cyborg has to be reached without a user '
+                      'token, but [service_user] is not configured. '
+                      'Set auth_type and the service user '
+                      'credentials in nova.conf.'))
+    return _SERVICE_USER_AUTH
+
+
 def get_client(context):
     return _CyborgClient(context)
 
