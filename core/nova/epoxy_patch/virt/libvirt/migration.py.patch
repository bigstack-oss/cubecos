+def _keep_vif_queues(interface_dev, src_driver):
+    # cube: keep the source's <driver> queues, not the (live-resized) flavor's
+    driver = interface_dev.find('driver')
+    if src_driver is None:
+        if driver is not None:
+            interface_dev.remove(driver)
+        return
+    src_queues = src_driver.get('queues')
+    if driver is None:
+        interface_dev.append(copy.deepcopy(src_driver))
+    elif src_queues is not None:
+        driver.set('queues', src_queues)
+    else:
+        driver.attrib.pop('queues', None)
+
