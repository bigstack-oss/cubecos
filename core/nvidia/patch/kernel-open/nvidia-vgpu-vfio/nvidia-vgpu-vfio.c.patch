+#if defined(NV_VFIO_DEVICE_OPS_HAS_GET_REGION_INFO_CAPS)
+/*
+ * VFIO_DEVICE_GET_REGION_INFO since Linux 6.19 (commit 775f726a742a): the VFIO
+ * core copies the request in and the reply and capability chain out, and asks
+ * the driver only for the region info, under the lock the ioctl path takes.
+ */
+int nv_vgpu_vfio_get_region_info_caps(vgpu_dev_t *vgpu_dev,
+                                      struct vfio_region_info *region_info,
+                                      struct vfio_info_cap *caps)
+{
+    int ret;
+
+    if (!vgpu_dev)
+    {
+        NV_VGPU_LOG(VGPU_ERR, "No vGPU device found, region info failed\n");
+        return -EINVAL;
+    }
+
+    down(&vgpu_dev->ops_lock);
+    ret = nv_vgpu_vfio_region_info(vgpu_dev, region_info, caps);
+    up(&vgpu_dev->ops_lock);
+
+    if (ret != 0)
+        NV_VGPU_DEV_LOG(VGPU_ERR, vgpu_dev,
+                        "VFIO IOCTL VFIO_DEVICE_GET_REGION_INFO failed. ret: %d\n", ret);
+
+    return ret;
+}
+#endif
