[Unit]
Description=OpenStack Image Service (code-named Glance) API server
After=syslog.target network.target

[Service]
LimitNOFILE=131072
LimitNPROC=131072
Type=simple
User=glance
# Point ExecStart to your venv binary and specify the configuration layout explicitly
ExecStart=/usr/bin/glance-api --config-file /etc/glance/glance-api.conf
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
