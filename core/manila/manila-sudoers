Defaults:manila !requiretty

manila ALL = (root) NOPASSWD: /usr/bin/manila-rootwrap /etc/manila/rootwrap.conf *
# This is what [manila_sys_admin] helper_command in manila.conf points at.
# There is no /usr/bin/privsep-helper any more -- it pointed at the antelope venv until
# #639 took the last service that needed it to caracal -- and a python 3.10 helper could
# not serve a caracal manila anyway, so the path is spelled out rather than left to
# sudo's secure_path.
# Only the lvm and glusterfs drivers reach privsep, and config_manila.cpp pins the
# backend to generic, so this is a safety net.
manila ALL = (root) NOPASSWD: /opt/openstack-caracal/bin/privsep-helper *
