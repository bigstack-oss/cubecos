#!/bin/sh
#
# pacemaker's ocf:ovn:ovndb-servers on CubeCOS: /usr/lib/ocf/resource.d/ovn/ovndb-servers
# points here instead of at the agent itself.
#
# OVN supports an ovn-controller newer than ovn-northd and the NB/SB databases, never
# older, but a 3.1.10 -> 3.1.20 roll reboots every control node before any compute. So a
# control node that carried an OVN 23.03 central across the upgrade keeps running the
# 23.03 one (ovn_central_compat_enter, sdk_ovn.sh) until every chassis runs 24.03, and
# ovn_central_switch then moves the whole cluster to 24.03 in one step.
#
# The agent is byte-identical in 23.03 and 24.03; only the ovn-ctl it drives differs, and
# it takes that from its ovn_ctl parameter. The parameter cannot be set on the resource:
# the CIB is shared with control nodes still on 3.1.10, which have no 23.03 tree here. So
# the choice is made per node, here, from whether this node holds 23.03 databases.
if [ -z "$OCF_RESKEY_ovn_ctl" ] && [ -e /etc/ovn/compat-23.03/ovnnb_db.db ] ; then
    export OCF_RESKEY_ovn_ctl=/usr/sbin/cube-ovn-ctl-compat
fi
exec /usr/share/ovn/scripts/ovndb-servers.ocf "$@"
