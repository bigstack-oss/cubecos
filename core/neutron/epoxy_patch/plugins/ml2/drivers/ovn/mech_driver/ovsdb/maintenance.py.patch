+    def update_virtual_port_parent_hostname(self):
+        """Virtual ports should have parent_hostname, NOT portbinding.host"""
+        # 1. List and store all virtual ports with
+        # "external_ids:neutron:host_id"
+        lsp_with_host_id = []
+        for lsp in self._nb_idl.lsp_list().execute(check_error=True):
+            if lsp.type != ovn_const.LSP_TYPE_VIRTUAL:
+                continue
+
+            if lsp.external_ids.get(ovn_const.OVN_HOST_ID_EXT_ID_KEY):
+                lsp_with_host_id.append(lsp)
+
+        # 2. For all these LSPs, **if present** during this second loop,
+        # (2.1) update the LSP.external_ids dictionary, (2.2) remove the
+        # Neutron port host and (2.3) update the Neutron port VIF details.
+        admin_context = n_context.get_admin_context()
+        for lsp in lsp_with_host_id:
+            host_id = lsp.external_ids[ovn_const.OVN_HOST_ID_EXT_ID_KEY]
+            self._ovn_client.update_virtual_port_parent_host(
+                admin_context, lsp.name, hostname=host_id)
+            self._nb_idl.db_remove(
+                'Logical_Switch_Port', lsp.uuid, 'external_ids',
+                ovn_const.OVN_HOST_ID_EXT_ID_KEY).execute(check_error=True)
+
+        raise periodics.NeverAgain()
+
+    def _get_ovn_mech_driver(self):
+        """Return the OVN mech driver that owns this OVN client."""
+        if self._ovn_mech_driver is None:
+            mech_manager = self._ovn_client._plugin.mechanism_manager
+            for ext in mech_manager.mech_drivers.values():
+                if (getattr(ext.obj, '_ovn_client_inst', None) is
+                        self._ovn_client):
+                    self._ovn_mech_driver = ext.obj
+                    break
+        return self._ovn_mech_driver
+
+    def _is_lsp_up_on_requested_chassis(self, port_id):
+        """True if the LSP is up, enabled and bound to its requested chassis.
+        """
+        lsp = self._nb_idl.get_lswitch_port(port_id)
+        if not lsp or not (utils.is_lsp_up(lsp) and
+                           utils.is_lsp_enabled(lsp)):
+            return False
+        requested = lsp.options.get(
+            ovn_const.LSP_OPTIONS_REQUESTED_CHASSIS_KEY)
+        if not requested:
+            return False
+        requested = set(requested.split(','))
+        for pb in self._sb_idl.db_find_rows(
+                'Port_Binding', ('logical_port', '=', port_id)).execute(
+                    check_error=True):
+            if pb.chassis and requested & {pb.chassis[0].name,
+                                           pb.chassis[0].hostname}:
+                return True
+        return False
+
+    @has_lock_periodic(spacing=PORT_STATUS_RECONCILE_SPACING)
+    def reconcile_port_status_up(self):
+        """Set compute ports up that OVN reports up but Neutron left DOWN.
+
+        Port status is only set from OVN events, which are never retried
+        if dropped (e.g. hashed to a dead hash ring node).
+        """
+        mech_driver = self._get_ovn_mech_driver()
+        if mech_driver is None:
+            return
+
+        context = n_context.get_admin_context()
+        cutoff = timeutils.utcnow() - datetime.timedelta(
+            seconds=PORT_STATUS_RECONCILE_MIN_AGE)
+        with db_api.CONTEXT_READER.using(context):
+            port_ids = [row.id for row in context.session.query(
+                models_v2.Port.id).join(
+                    standard_attr.StandardAttribute,
+                    models_v2.Port.standard_attr_id ==
+                    standard_attr.StandardAttribute.id).filter(
+                        models_v2.Port.status == n_const.PORT_STATUS_DOWN,
+                        models_v2.Port.device_owner.startswith(
+                            n_const.DEVICE_OWNER_COMPUTE_PREFIX),
+                        standard_attr.StandardAttribute.updated_at < cutoff)]
+
+        reconciled = 0
+        for port_id in port_ids:
+            if reconciled >= PORT_STATUS_RECONCILE_MAX_PORTS:
+                break
+            if not self._is_lsp_up_on_requested_chassis(port_id):
+                continue
+            reconciled += 1
+            LOG.info("Maintenance task: port %s is up in OVN but DOWN in "
+                     "Neutron, setting it up", port_id)
+            try:
+                mech_driver.set_port_status_up(port_id)
+            except Exception:
+                LOG.exception("Maintenance task: failed to set port %s up",
+                              port_id)
