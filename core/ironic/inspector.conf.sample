#ethoib_interfaces =

# The IP version that will be used for iptables filter. Defaults to 4.
# (string value)
# Possible values:
# 4 - IPv4
# 6 - IPv6
#ip_version = 4


[ironic]

#
# From ironic_inspector
#

# Authentication URL (string value)
#auth_url = <None>

# Authentication type to load (string value)
