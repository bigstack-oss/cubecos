dbrp "telegraf"."def"

var data = stream
  |from()
    .measurement('ceph_osd_usage')
    .groupBy('component')
  |eval(lambda: unixNano(now()))
    .as('ts')
    .keep()
  |eval(lambda: int("used_percent"))
    .as('used')
    .keep()

data
  |alert()
    .info(lambda: int("used") <= 85 AND int("used") > 75)
    .infoReset(lambda: int("used") <= 65)
    .stateChangesOnly()
    .noRecoveries()
    .message('system,category=CEP,severity=I,key=CEP00003I,host={{ .Tags.host }} message="host "{{ .Tags.host }}" osd "{{ .Tags.component }}" usage {{ .Fields.used }}% exceeds threshold 75%",metadata="{ "category": "cep", "host": "{{ .Tags.host }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')

data
  |alert()
    .warn(lambda: int("used") > 85)
    .warnReset(lambda: int("used") <= 75)
    .stateChangesOnly()
    .noRecoveries()
    .message('system,category=CEP,severity=W,key=CEP00004W,host={{ .Tags.host }} message="host "{{ .Tags.host }}" osd "{{ .Tags.component }}" usage {{ .Fields.used }}% exceeds threshold 85%",metadata="{ "category": "cep", "host": "{{ .Tags.host }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')
