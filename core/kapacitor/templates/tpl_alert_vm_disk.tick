// The per-filesystem series this streams from is written by
// `hex_sdk storage_usage_collect` straight to the kapacitor write proxy on :9092,
// the same ingress and database the cpu and memory templates use after the
// monasca retirement (issue #672 phase 3). telegraf.def because it already has
// the retention policy, the relay task that copies a write out to the peer
// control nodes, and the Grafana datasource.
dbrp "telegraf"."def"

var where_filter = lambda: TRUE

var data = stream
  |from()
    .measurement('vm.disk.usage_perc')
    .where(where_filter)
    .groupBy('resource_id', 'mountpoint')
  |eval(lambda: unixNano(now()))
    .as('ts')
    .keep()
  |eval(lambda: int("value"))
    .as('used')
    .keep()

data
  |alert()
    .info(lambda: int("used") <= 85 AND int("used") > 75)
    .infoReset(lambda: int("used") <= 65)
    .stateChangesOnly()
    .noRecoveries()
    .message('instance,category=DSK,severity=I,key=DSK00004I,tenant={{ .Tags.tenant_id }},instance={{ .Tags.resource_id }},vm_name={{ .Tags.vm_name }} message="project "{{ .Tags.tenant_name }}" instance "{{ .Tags.vm_name }}" filesystem "{{ .Tags.mountpoint }}" disk usage {{ .Fields.used }}% exceeds threshold 75%",metadata="{ "category": "disk", "tenant": "{{ .Tags.tenant_id }}", "instance": "{{ .Tags.resource_id }}", "mountpoint": "{{ .Tags.mountpoint }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')

data
  |alert()
    .warn(lambda: int("used") <= 95 AND int("used") > 85)
    .warnReset(lambda: int("used") <= 75)
    .stateChangesOnly()
    .noRecoveries()
    .message('instance,category=DSK,severity=W,key=DSK00005W,tenant={{ .Tags.tenant_id }},instance={{ .Tags.resource_id }},vm_name={{ .Tags.vm_name }} message="project "{{ .Tags.tenant_name }}" instance "{{ .Tags.vm_name }}" filesystem "{{ .Tags.mountpoint }}" disk usage {{ .Fields.used }}% exceeds threshold 85%",metadata="{ "category": "disk", "tenant": "{{ .Tags.tenant_id }}", "instance": "{{ .Tags.resource_id }}", "mountpoint": "{{ .Tags.mountpoint }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')

data
  |alert()
    .crit(lambda: int("used") > 95)
    .critReset(lambda: int("used") <= 85)
    .stateChangesOnly()
    .noRecoveries()
    .message('instance,category=DSK,severity=C,key=DSK00006C,tenant={{ .Tags.tenant_id }},instance={{ .Tags.resource_id }},vm_name={{ .Tags.vm_name }} message="project "{{ .Tags.tenant_name }}" instance "{{ .Tags.vm_name }}" filesystem "{{ .Tags.mountpoint }}" disk usage {{ .Fields.used }}% exceeds threshold 95%",metadata="{ "category": "disk", "tenant": "{{ .Tags.tenant_id }}", "instance": "{{ .Tags.resource_id }}", "mountpoint": "{{ .Tags.mountpoint }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')

data
  |alert()
    .info(lambda: int("used") < 50)
    .infoReset(lambda: int("used") <= 75)
    .stateChangesOnly()
    .noRecoveries()
    .message('instance,category=DSK,severity=I,key=DSK00007I,tenant={{ .Tags.tenant_id }},instance={{ .Tags.resource_id }},vm_name={{ .Tags.vm_name }} message="project "{{ .Tags.tenant_name }}" instance "{{ .Tags.vm_name }}" filesystem "{{ .Tags.mountpoint }}" disk usage {{ .Fields.used }}% is normal",metadata="{ "category": "disk", "tenant": "{{ .Tags.tenant_id }}", "instance": "{{ .Tags.resource_id }}", "mountpoint": "{{ .Tags.mountpoint }}" }" {{ .Fields.ts }}')
    .post()
      .endpoint('events')
