Listen @BIND_ADDR@5000
Listen @BIND_ADDR@5443

# ==========================================
# Port 5000: Standard Public API Proxy
# ==========================================
<VirtualHost *:5000>
    ProxyPreserveHost On
    ProxyRequests Off

    ProxyPass / unix:/var/lib/keystone/keystone.socket|http://localhost/
    ProxyPassReverse / unix:/var/lib/keystone/keystone.socket|http://localhost/

    <IfVersion >= 2.4>
      ErrorLogFormat "%{cu}t %M"
    </IfVersion>
    ErrorLog /var/log/httpd/keystone.log
    CustomLog /var/log/httpd/keystone_access.log combined
</VirtualHost>

# ==========================================
# Port 5443: Secure HTTPS / Keycloak SAML Proxy
# ==========================================
<VirtualHost *:5443>
    SSLEngine on
    SSLCertificateFile /var/www/certs/server.cert
    SSLCertificateKeyFile /var/www/certs/server.key

    ProxyPreserveHost On
    ProxyRequests Off

    # Pass Mellon environment data down to the Gunicorn UNIX Socket
    ProxyPass / unix:/var/lib/keystone/keystone.socket|http://localhost/
    ProxyPassReverse / unix:/var/lib/keystone/keystone.socket|http://localhost/

    <IfVersion >= 2.4>
      ErrorLogFormat "%{cu}t %M"
    </IfVersion>
    ErrorLog /var/log/httpd/keystone-ssl.log
    CustomLog /var/log/httpd/keystone-ssl_access.log combined
</VirtualHost>

# ==========================================
# Legacy Route Map /identity Translation
# ==========================================
<Location /identity>
    ProxyPreserveHost On
    ProxyPass unix:/var/lib/keystone/keystone.socket|http://localhost/
    ProxyPassReverse unix:/var/lib/keystone/keystone.socket|http://localhost/
</Location>
