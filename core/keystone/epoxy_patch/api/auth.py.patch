+def _origin_matches(origin, trusted):
+    """Match an origin against one trusted_dashboard entry.
+
+    Equality, except that a "*" in the entry matches within the host only.
+    Scheme, port and path are still compared exactly: the origin becomes the
+    form action the token is posted to, so a wildcard allowed to span "/" or
+    "?" would match a host the entry never named.
+    """
+    if '*' not in trusted:
+        return origin == trusted
+    try:
+        o = urllib.parse.urlsplit(origin)
+        t = urllib.parse.urlsplit(trusted)
+        ports = (o.port, t.port)
+    except ValueError:
+        return False
+    if o.username or o.password or t.username or t.password:
+        return False
+    if not o.hostname or not t.hostname:
+        return False
+    if (o.scheme, ports[0], o.path, o.query, o.fragment) != (
+        t.scheme,
+        ports[1],
+        t.path,
+        t.query,
+        t.fragment,
+    ):
+        return False
+    return fnmatch.fnmatchcase(o.hostname, t.hostname)
+
