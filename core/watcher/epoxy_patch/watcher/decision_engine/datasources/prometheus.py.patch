+    def _build_host_sensor_query(self, meter_name, meter, aggregate,
+                                 instance_label, period):
+        """CubeCOS: PromQL for a host_* ipmi_exporter sensor meter
+
+        Pins every selector in the ' or '-joined meter to the host's
+        fqdn_label, reduces the matched sensors with max() and applies the
+        meter's HOST_SENSOR_SCALE. None for a host Prometheus does not know.
+        """
+        if instance_label is None:
+            return None
+        pin = "%s='%s'" % (self.prometheus_fqdn_label, instance_label)
+        parts = []
+        for sel in meter.split(' or '):
+            sel = sel.strip()
+            if '{' in sel:
+                sel = sel.replace('{', '{%s,' % pin, 1)
+            else:
+                sel = '%s{%s}' % (sel, pin)
+            parts.append('max(%s_over_time(%s[%ss]))' %
+                         (aggregate, sel, period))
+        query = ' or '.join(parts)
+        scale = self.HOST_SENSOR_SCALE.get(meter_name, 1)
+        if scale != 1:
+            query = '(%s) * %s' % (query, scale)
+        return query
+
