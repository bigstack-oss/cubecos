#period = 3600


[watcher_datasources]

#
# From watcher
#

# Datasources to use in order to query the needed metrics. If one of strategy
# metric is not available in the first datasource, the next datasource will be
# chosen. This is the default for all strategies unless a strategy has a
# specific override. (list value)
#datasources = gnocchi,ceilometer,monasca,grafana

# How many times Watcher is trying to query again (integer value)
# Minimum value: 1
# Note: This option can be changed without restarting.
#query_max_retries = 10

# How many seconds Watcher should wait to do query again (integer value)
# Minimum value: 0
# Note: This option can be changed without restarting.
#query_timeout = 1


[watcher_decision_engine]

#
# From watcher
#

# The topic name used for control events, this topic used for RPC calls (string
# value)
#conductor_topic = watcher.decision.control

# The exchange and topic names from which notification events will be listened
# to. The exchange should be specified to get an ability to use pools. (list
# value)
#notification_topics = nova.versioned_notifications,watcher.watcher_notifications

# The identifier used by the Watcher module on the message broker (string
# value)
#publisher_id = watcher.decision.api

# The maximum number of threads that can be used to execute audits in parallel.
# (integer value)
#max_audit_workers = 2

# The maximum number of threads that can be used to execute general tasks in
# parallel. The number of general workers will not increase depending on the
# number of audit workers! (integer value)
#max_general_workers = 4

# An expiry timespan(hours). Watcher invalidates any action plan for which its
# creation time -whose number of hours has been offset by this value- is older
# that the current time. (integer value)
# Note: This option can be changed without restarting.
#action_plan_expiry = 24

# Interval (in seconds) for checking action plan expiry. (integer value)
# Note: This option can be changed without restarting.
#check_periodic_interval = 1800

# Path to metric map yaml formatted file.  The file contains a map per
# datasource whose keys are the metric names as recognized by watcher and the
# value is the real name of the metric in the datasource. For example::
#
#   monasca:
#     instance_cpu_usage: VM_CPU
#   gnocchi:
#     instance_cpu_usage: cpu_vm_util
#
# This file is optional. (string value)
#metric_map_path = /etc/watcher/metric_map.yaml

# Interval (in seconds) for checking newly created continuous audits. (integer
# value)
# Note: This option can be changed without restarting.
#continuous_audit_interval = 10


[watcher_planner]

