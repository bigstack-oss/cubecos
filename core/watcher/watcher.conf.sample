# (integer value)
#period = 3600


[watcher_cluster_data_model_collectors.compute]

#
# From watcher
#

# The time interval (in seconds) between each synchronization of the model
# (integer value)
#period = 3600


[watcher_cluster_data_model_collectors.storage]

#
